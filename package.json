{
  "name": "bachs-vue",
  "version": "0.1.0",
  "description": "Community Vue composables and Nuxt module for Bachs checkout and billing.",
  "type": "module",
  "license": "MIT",
  "author": "DevAdedeji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevAdedeji/bachs-vue.git"
  },
  "homepage": "https://github.com/DevAdedeji/bachs-vue#readme",
  "bugs": {
    "url": "https://github.com/DevAdedeji/bachs-vue/issues"
  },
  "keywords": [
    "bachs",
    "vue",
    "nuxt",
    "billing",
    "checkout",
    "payments"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/server/browser.js",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/check-package.mjs",
    "dev": "nuxt dev examples/nuxt",
    "example:prepare": "nuxt prepare examples/nuxt",
    "example:typecheck": "nuxt typecheck examples/nuxt",
    "example:build": "nuxt build examples/nuxt",
    "example:vue": "vite examples/vue",
    "example:vue:build": "vite build examples/vue",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run test:package && npm run example:typecheck && npm run example:build && npm run example:vue:build",
    "prepack": "npm run build",
    "test:consumer": "node scripts/test-consumer.mjs",
    "sandbox:seed": "node scripts/seed-sandbox.mjs"
  },
  "dependencies": {
    "@bachs/js": "^0.2.0",
    "@nuxt/kit": "^4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "nuxt": "^3.17.0 || ^4.0.0",
    "h3": "^1.15.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "h3": "^1.15.0",
    "happy-dom": "^20.0.0",
    "nuxt": "^4.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
